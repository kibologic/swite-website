import { SwissComponent } from '@kibologic/core';
import { Shell } from '../components/Shell.uix';

component DocsPage {
  props = {
    route: string,
  };

  section(title: string, summary: string, body: unknown) {
    return (
      <div>
        <div class="sw-hero">
          <h1 class="sw-h1">{title}</h1>
          <p class="sw-lede">{summary}</p>
        </div>
        <div class="sw-content">{body}</div>
      </div>
    );
  }

  code(block: string) {
    return (
      <div class="sw-code">
        <pre>{block}</pre>
      </div>
    );
  }

  intro() {
    return this.section(
      'Introduction',
      'Swite is the development server and compiler host used by SwissJS applications across Kibologic.',
      [
        <div class="sw-grid" key="intro-grid">
          <div class="sw-card">
            <h3>What it does</h3>
            <p>Serves and compiles <span class="sw-inline">.ui</span>/<span class="sw-inline">.uix</span>, wires static assets, runs HMR, and owns resolver behavior.</p>
          </div>
          <div class="sw-card">
            <h3>Where truth lives</h3>
            <p>Source of truth is <span class="sw-inline">kibologic/swite</span>. If this site and the repo disagree, the repo wins.</p>
          </div>
        </div>,
      ]
    );
  }

  install() {
    return this.section(
      'Installation',
      'Swite is consumed as an npm package in app repos and driven via a `dev.mjs` entry.',
      [
        this.code(`# pnpm\npnpm add -D @kibologic/swite\n\n# dev\nnode dev.mjs\n`),
      ]
    );
  }

  config() {
    return this.section(
      'Configuration',
      'Swite config focuses on app root, public assets, server port/host, and service wiring (e.g. python services) for integrated stacks.',
      [
        this.code(`// dev.mjs\nimport { SwiteServer } from '@kibologic/swite';\n\nconst server = new SwiteServer({\n  root: new URL('./app', import.meta.url).pathname,\n  publicDir: 'public',\n  port: 6002,\n  host: '0.0.0.0',\n  open: false,\n});\n\nawait server.start();\n`),
      ]
    );
  }

  cli() {
    return this.section(
      'CLI Commands',
      'Swite exposes a CLI and a programmatic server. In Kibologic repos, `dev.mjs` is the standard entrypoint.',
      [
        <div class="sw-grid" key="cli-grid">
          <div class="sw-card">
            <h3>dev</h3>
            <p>Local dev server with HMR.</p>
          </div>
          <div class="sw-card">
            <h3>build</h3>
            <p>Build pipeline for production outputs (when used).</p>
          </div>
        </div>,
      ]
    );
  }

  hmr() {
    return this.section(
      'HMR',
      'Swite runs a WebSocket HMR server; when the default port is busy, it chooses a free port and continues.',
      [
        <div class="sw-card" key="hmr-card">
          <h3>Operational note</h3>
          <p>In the Kibologic workspace we do not change allocated app ports; if a port is busy, kill the old process and restart.</p>
        </div>,
      ]
    );
  }

  resolution() {
    return this.section(
      'Module Resolution',
      'Swite maps workspace and sibling `node_modules` layouts to stable browser import paths so apps can share packages during development.',
      [
        <div class="sw-card" key="res-card">
          <h3>Why it matters</h3>
          <p>Resolver behavior is foundational for multi-repo setups where packages live in sibling repos but are consumed in the browser.</p>
        </div>,
      ]
    );
  }

  plugins() {
    return this.section(
      'Plugin Surface',
      'Swite integrates with SwissJS plugin surfaces (for example file-router patterns) to deliver predictable app structure.',
      [
        <div class="sw-card" key="pl-card">
          <h3>Rule</h3>
          <p>If an app needs a tooling change, we fix upstream in <span class="sw-inline">kibologic/swite</span> (not via app workarounds or hot-editing node_modules).</p>
        </div>,
      ]
    );
  }

  errors() {
    return this.section(
      'Troubleshooting',
      'Common failure modes are usually port conflicts, resolver mismatches, or environment overrides.',
      [
        <div class="sw-grid" key="err-grid">
          <div class="sw-card">
            <h3>Port in use</h3>
            <p>Kill the running process and restart. Don’t drift from registry-allocated ports.</p>
          </div>
          <div class="sw-card">
            <h3>Env override</h3>
            <p>Shell env vars override <span class="sw-inline">.env</span> loaders; check for whitespace/newlines in URLs when debugging auth issues.</p>
          </div>
        </div>,
      ]
    );
  }

  why() {
    return this.section(
      'Why Swite',
      'Swite exists because SwissJS needed a dev server and build surface that understands SwissJS file formats and Kibologic workspace constraints.',
      [
        <div class="sw-card" key="why-card">
          <h3>Not “just Vite”</h3>
          <p>Swite’s core value is owning the SwissJS compilation + resolver model in a way that matches how Kibologic repos are structured.</p>
        </div>,
      ]
    );
  }

  content() {
    const r = this.props.route;
    if (r === '/docs' || r === '/docs/') return this.intro();
    if (r === '/docs/install') return this.install();
    if (r === '/docs/config') return this.config();
    if (r === '/docs/cli') return this.cli();
    if (r === '/docs/hmr') return this.hmr();
    if (r === '/docs/resolution') return this.resolution();
    if (r === '/docs/plugins') return this.plugins();
    if (r === '/docs/errors') return this.errors();
    if (r === '/why-swite') return this.why();
    return this.section('Not found', 'This route is outside the current Swite docs surface.', []);
  }

  render() {
    return (
      <Shell activeRoute={this.props.route}>
        {this.content()}
      </Shell>
    );
  }
}

