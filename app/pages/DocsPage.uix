import { SwissComponent } from '@kibologic/core';
import { Shell } from '../components/Shell.uix';

component DocsPage {
  props = {
    route: string
  };

  renderSection(title: string, summary: string, body: unknown) {
    return (
      <section>
        <div style="margin-bottom: 24px;">
          <div style="margin-bottom: 10px; font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.14em;">Swite Reference</div>
          <h1 style="margin: 0 0 10px; font-size: 42px; letter-spacing: -0.05em;">{title}</h1>
          <p style="margin: 0; color: var(--text-secondary); font-size: 15px; max-width: 820px;">{summary}</p>
        </div>
        <div style="display: flex; flex-direction: column; gap: 18px;">{body}</div>
      </section>
    );
  }

  renderOverview() {
    return this.renderSection(
      'Introduction',
      'Swite is the SwissJS development server and runtime toolchain. It serves source files directly in dev, compiles SwissJS file types on demand, manages HMR, and provides the local server surface SwissJS apps run on.',
      [
        <div class="sw-doc-card" key="overview-1">
          <h3 style="margin: 0 0 10px; font-size: 16px;">Core exports</h3>
          <p style="margin: 0; color: var(--text-secondary); font-size: 14px;">
            The package exports <code class="sw-inline-code">SwiteServer</code>, <code class="sw-inline-code">defineConfig</code>,
            builder APIs, resolver APIs, HMR, config loading, Python proxy helpers, and Python dev-service management.
          </p>
        </div>,
        <div class="sw-doc-card" key="overview-2">
          <h3 style="margin: 0 0 10px; font-size: 16px;">File model</h3>
          <p style="margin: 0; color: var(--text-secondary); font-size: 14px;">
            Swite is aware of SwissJS source formats. It has dedicated handling for <code class="sw-inline-code">.ui</code> and
            <code class="sw-inline-code"> .uix</code>, along with TypeScript, JavaScript, static assets, and node_modules-backed browser imports.
          </p>
        </div>,
        <div class="sw-doc-note" key="overview-3">
          The most grounded mental model is: Swite is the local application server SwissJS expects during development.
        </div>
      ]
    );
  }

  renderInstall() {
    return this.renderSection(
      'Installation',
      'The current site reflects how Swite is used in Kibologic repos today: installed as a package, then used through a small Node entry like dev.mjs or through the swite CLI.',
      [
        <div class="sw-code-block" key="install-code">
{`npm install -D @kibologic/swite

# then either:
node dev.mjs

# or:
swite dev`}
        </div>,
        <div class="sw-doc-card" key="install-notes">
          <h3 style="margin: 0 0 10px; font-size: 16px;">Typical repository shape</h3>
          <p style="margin: 0 0 10px; color: var(--text-secondary); font-size: 14px;">
            Kibologic sites use a small repo with an <code class="sw-inline-code">app/</code> directory, <code class="sw-inline-code">main.ui</code>,
            page components, a public HTML shell, and a <code class="sw-inline-code">dev.mjs</code> file that instantiates <code class="sw-inline-code">SwiteServer</code>.
          </p>
          <p style="margin: 0; color: var(--text-secondary); font-size: 14px;">
            Larger apps like Alpine ERP Core use the same server class, but compose it with monorepo-aware serving, proxy middleware, and service registry lookups.
          </p>
        </div>
      ]
    );
  }

  renderConfig() {
    return this.renderSection(
      'Configuration',
      'Swite ships a typed config surface through defineConfig. The current source supports server config and an optional services.python block.',
      [
        <div class="sw-code-block" key="config-code">
{`import { defineConfig } from '@kibologic/swite';

export default defineConfig({
  server: {
    port: 3000,
    host: 'localhost'
  },
  services: {
    python: {
      entry: './services/main.py',
      port: 8000,
      autoStart: true,
      healthCheck: '/health',
      env: {}
    }
  }
});`}
        </div>,
        <div class="sw-doc-card" key="config-fields">
          <h3 style="margin: 0 0 10px; font-size: 16px;">Current typed fields</h3>
          <ul style="margin: 0; padding-left: 18px; color: var(--text-secondary); font-size: 14px;">
            <li><code class="sw-inline-code">server.port</code> and <code class="sw-inline-code">server.host</code></li>
            <li><code class="sw-inline-code">services.python.entry</code></li>
            <li><code class="sw-inline-code">services.python.port</code></li>
            <li><code class="sw-inline-code">services.python.autoStart</code></li>
            <li><code class="sw-inline-code">services.python.healthCheck</code></li>
            <li><code class="sw-inline-code">services.python.env</code></li>
          </ul>
        </div>,
        <div class="sw-doc-note" key="config-note">
          Alpine ERP Core’s current <code class="sw-inline-code">swiss.config.ts</code> uses this Python service shape directly.
        </div>
      ]
    );
  }

  renderCli() {
    return this.renderSection(
      'CLI Commands',
      'The CLI currently exposes three commands: dev, start, and build.',
      [
        <div class="sw-doc-card" key="cli-dev">
          <h3 style="margin: 0 0 8px; font-size: 16px;">swite dev</h3>
          <p style="margin: 0; color: var(--text-secondary); font-size: 14px;">
            Loads config, optionally auto-starts the configured Python service, registers exit handlers, and starts SwiteServer in development mode.
          </p>
        </div>,
        <div class="sw-doc-card" key="cli-start">
          <h3 style="margin: 0 0 8px; font-size: 16px;">swite start</h3>
          <p style="margin: 0; color: var(--text-secondary); font-size: 14px;">
            Loads config, switches Python proxying to production assumptions, warns when a Python service is configured but <code class="sw-inline-code">PYTHON_SERVICE_URL</code> is missing, and starts the server.
          </p>
        </div>,
        <div class="sw-doc-card" key="cli-build">
          <h3 style="margin: 0 0 8px; font-size: 16px;">swite build</h3>
          <p style="margin: 0; color: var(--text-secondary); font-size: 14px;">
            Uses <code class="sw-inline-code">SwiteBuilder</code> with an entry such as <code class="sw-inline-code">src/index.ui</code> and writes a built output directory.
          </p>
        </div>
      ]
    );
  }

  renderHmr() {
    return this.renderSection(
      'HMR',
      'Swite runs its own HMR engine. It starts a WebSocket server, watches the project tree, and classifies file changes into update types.',
      [
        <div class="sw-doc-card" key="hmr-1">
          <h3 style="margin: 0 0 8px; font-size: 16px;">Port handling</h3>
          <p style="margin: 0; color: var(--text-secondary); font-size: 14px;">
            The HMR engine defaults to port <code class="sw-inline-code">24678</code>. If that port is occupied, it searches for a free port and continues.
          </p>
        </div>,
        <div class="sw-doc-card" key="hmr-2">
          <h3 style="margin: 0 0 8px; font-size: 16px;">File watching</h3>
          <p style="margin: 0; color: var(--text-secondary); font-size: 14px;">
            Swite watches the project root while ignoring <code class="sw-inline-code">node_modules</code>, <code class="sw-inline-code">.git</code>, and <code class="sw-inline-code">dist</code>.
          </p>
        </div>,
        <div class="sw-doc-card" key="hmr-3">
          <h3 style="margin: 0 0 8px; font-size: 16px;">Update behavior</h3>
          <p style="margin: 0; color: var(--text-secondary); font-size: 14px;">
            Style changes are hot-swapped, some module changes are treated as hot updates, and everything else falls back to full page reload. That behavior comes from Swite’s own HMR client script, not a borrowed frontend runtime.
          </p>
        </div>
      ]
    );
  }

  renderResolution() {
    return this.renderSection(
      'Module Resolution',
      'Swite’s resolution logic is one of the reasons it exists. It has to serve SwissJS apps that span app roots, workspace packages, sibling monorepos, and node_modules-backed browser imports.',
      [
        <div class="sw-doc-card" key="res-1">
          <h3 style="margin: 0 0 8px; font-size: 16px;">Symlink registry</h3>
          <p style="margin: 0; color: var(--text-secondary); font-size: 14px;">
            Before the server handles requests, it builds a symlink registry so workspace package paths can map back to clean browser URLs.
          </p>
        </div>,
        <div class="sw-doc-card" key="res-2">
          <h3 style="margin: 0 0 8px; font-size: 16px;">Workspace and sibling repo search</h3>
          <p style="margin: 0; color: var(--text-secondary); font-size: 14px;">
            Swite checks local app node_modules, parent package node_modules, workspace roots, and detected sibling monorepos such as swiss-lib when resolving imports.
          </p>
        </div>,
        <div class="sw-doc-card" key="res-3">
          <h3 style="margin: 0 0 8px; font-size: 16px;">SwissJS-specific import rewriting</h3>
          <p style="margin: 0; color: var(--text-secondary); font-size: 14px;">
            The import rewriter preserves and repairs SwissJS file extensions, especially around <code class="sw-inline-code">.ui</code> and <code class="sw-inline-code">.uix</code>, so browser-facing module paths still point at valid SwissJS source.
          </p>
        </div>
      ]
    );
  }

  renderStatic() {
    return this.renderSection(
      'Static Files',
      'Swite serves static assets alongside compiled SwissJS sources. In Kibologic repos this usually includes `public/`, selected `node_modules` assets, and optional `/lib` mounts.',
      [
        <div class="sw-doc-card" key="static-1">
          <h3 style="margin: 0 0 8px; font-size: 16px;">publicDir</h3>
          <p style="margin: 0; color: var(--text-secondary); font-size: 14px;">
            Configure <code class="sw-inline-code">publicDir</code> to serve HTML/CSS/assets under the app root (commonly <code class="sw-inline-code">public</code>).
          </p>
        </div>,
        <div class="sw-doc-card" key="static-2">
          <h3 style="margin: 0 0 8px; font-size: 16px;">node_modules assets</h3>
          <p style="margin: 0; color: var(--text-secondary); font-size: 14px;">
            Some apps mount a safe subset of files from <code class="sw-inline-code">node_modules</code> (for example a prebuilt JS file required by an import map).
          </p>
        </div>,
        <div class="sw-doc-note" key="static-3">
          If CSS or browser assets 404, confirm whether the repo expects a <code class="sw-inline-code">/lib</code> directory mount or explicit middleware and ensure the expected paths exist in that workspace layout.
        </div>,
        <div class="sw-code-block" key="static-code">
{`// dev.mjs (typical)
import { SwiteServer } from '@kibologic/swite';

const server = new SwiteServer({
  root: new URL('./app', import.meta.url).pathname,
  publicDir: 'public',
});

await server.start();`}
        </div>
      ]
    );
  }

  renderPlugins() {
    return this.renderSection(
      'Plugin Surface',
      'Swite is already wired to first-party SwissJS plugins, especially file-router integration.',
      [
        <div class="sw-doc-card" key="plugins-1">
          <h3 style="margin: 0 0 8px; font-size: 16px;">File router</h3>
          <p style="margin: 0; color: var(--text-secondary); font-size: 14px;">
            The middleware setup boots a file-router scanner, tracks discovered routes, and watches route files for change notifications.
          </p>
        </div>,
        <div class="sw-doc-card" key="plugins-2">
          <h3 style="margin: 0 0 8px; font-size: 16px;">Route-aware HMR surface</h3>
          <p style="margin: 0; color: var(--text-secondary); font-size: 14px;">
            HMR routes are part of the server setup, and route metadata is exposed so the dev surface can reason about current route files.
          </p>
        </div>
      ]
    );
  }

  renderErrors() {
    return this.renderSection(
      'Troubleshooting',
      'Most Swite issues in practice come from resolution mismatches, missing static asset paths, or backend service assumptions.',
      [
        <div class="sw-doc-card" key="err-1">
          <h3 style="margin: 0 0 8px; font-size: 16px;">Bare imports reaching the browser</h3>
          <p style="margin: 0; color: var(--text-secondary); font-size: 14px;">
            When bare specifiers are not rewritten to browser-valid URLs, the app fails in the browser. Swite’s import rewriting docs exist because this is a real failure mode.
          </p>
        </div>,
        <div class="sw-doc-card" key="err-2">
          <h3 style="margin: 0 0 8px; font-size: 16px;">Missing lib or static asset paths</h3>
          <p style="margin: 0; color: var(--text-secondary); font-size: 14px;">
            Some repos still rely on explicit static middleware because missing paths can cause CSS or browser module requests to fail.
          </p>
        </div>,
        <div class="sw-doc-card" key="err-3">
          <h3 style="margin: 0 0 8px; font-size: 16px;">Python service assumptions</h3>
          <p style="margin: 0; color: var(--text-secondary); font-size: 14px;">
            If <code class="sw-inline-code">services.python</code> is configured, dev and start modes have explicit expectations around health checks and <code class="sw-inline-code">PYTHON_SERVICE_URL</code>.
          </p>
        </div>
      ]
    );
  }

  renderWhySwite() {
    return this.renderSection(
      'Why Swite',
      'Kibologic built Swite because SwissJS has its own source model, runtime assumptions, and monorepo behavior. A generic dev server is not enough once the framework owns .ui, .uix, runtime-aware resolution, and local backend orchestration.',
      [
        <div class="sw-doc-card" key="why-1">
          <p style="margin: 0; color: var(--text-secondary); font-size: 14px;">
            The right framing is not “faster than X” or “better marketing story than Y.” The right framing is architectural fit: Swite exists because SwissJS applications need a server that understands their files, routing, import graph, and development environment.
          </p>
        </div>,
        <div class="sw-doc-note" key="why-2">
          Alpine ERP Core is the strongest evidence. It uses Swite as the server surface that fronts a SwissJS app while coordinating Python services, proxies, workspace modules, and local runtime behavior.
        </div>
      ]
    );
  }

  renderNotFound() {
    return (
      <section>
        <div style="margin-bottom: 24px;">
          <div style="margin-bottom: 10px; font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.14em;">Swite Reference</div>
          <h1 style="margin: 0 0 10px; font-size: 42px; letter-spacing: -0.05em;">Route not documented yet</h1>
          <p style="margin: 0; color: var(--text-secondary); font-size: 15px; max-width: 760px;">
            This route is outside the current Swite reference set. Use the sidebar to navigate to the sections backed by the current codebase.
          </p>
        </div>
      </section>
    );
  }

  renderContent() {
    if (this.route === '/docs' || this.route === '/docs/') return this.renderOverview();
    if (this.route === '/docs/install') return this.renderInstall();
    if (this.route === '/docs/config') return this.renderConfig();
    if (this.route === '/docs/cli') return this.renderCli();
    if (this.route === '/docs/hmr') return this.renderHmr();
    if (this.route === '/docs/resolution') return this.renderResolution();
    if (this.route === '/docs/static') return this.renderStatic();
    if (this.route === '/docs/plugins') return this.renderPlugins();
    if (this.route === '/docs/errors') return this.renderErrors();
    if (this.route === '/why-swite') return this.renderWhySwite();
    return this.renderNotFound();
  }

  render() {
    return <Shell activeRoute={this.route}>{this.renderContent()}</Shell>;
  }
}
