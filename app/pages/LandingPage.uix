import { SwissComponent } from '@kibologic/core';
import { Navbar } from '../components/Navbar.uix';
import { Footer } from '../components/Footer.uix';
import { Hero } from '../components/home/Hero.uix';
import { Features } from '../components/home/Features.uix';
import { QuickStart } from '../components/home/QuickStart.uix';

component LandingPage {
  props = {};

  state { let theme: 'light' | 'dark' = 'dark'; }

  mounted() {
    const saved = localStorage.getItem('swite-theme') as 'light' | 'dark' | null;
    this.theme = saved || 'dark';
    document.documentElement.setAttribute('data-theme', this.theme);

    if (!document.getElementById('swite-global-styles')) {
      const s = document.createElement('style');
      s.id = 'swite-global-styles';
      s.textContent = `
        :root {
          --color-slate-50:  #F7F8FA;
          --color-slate-100: #ECEEF2;
          --color-slate-200: #D4D8E0;
          --color-slate-500: #7A8499;
          --color-slate-700: #3D4559;
          --color-slate-900: #1A2035;
          --brand-accent: #50fa7b;
          --brand-accent-hover: #3ddc67;
          --brand-accent-subtle: rgba(80, 250, 123, 0.1);
        }
        [data-theme="light"] {
          --bg-page: #FFFFFF;
          --bg-surface: var(--color-slate-50);
          --bg-inverse: var(--color-slate-900);
          --text-primary: var(--color-slate-900);
          --text-secondary: var(--color-slate-700);
          --text-muted: var(--color-slate-500);
          --border: var(--color-slate-200);
          --code-bg: var(--color-slate-900);
        }
        [data-theme="dark"] {
          --bg-page: #000000;
          --bg-surface: #111111;
          --bg-inverse: #FFFFFF;
          --text-primary: #FFFFFF;
          --text-secondary: var(--color-slate-500);
          --text-muted: #888888;
          --border: #222222;
          --code-bg: #0A0A0A;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        html { scroll-behavior: smooth; }
        body {
          font-family: 'JetBrains Mono', 'Fira Code', monospace;
          background: var(--bg-page);
          color: var(--text-primary);
          transition: background 0.3s ease;
        }
      `;
      document.head.appendChild(s);
    }
  }

  _toggleTheme() {
    this.theme = this.theme === 'light' ? 'dark' : 'light';
    document.documentElement.setAttribute('data-theme', this.theme);
    localStorage.setItem('swite-theme', this.theme);
  }

  render() {
    return (
      <div style="min-height: 100vh; display: flex; flex-direction: column;">
        <Navbar theme={this.theme} onToggleTheme={() => this._toggleTheme()} />
        <main style="flex: 1;">
          <Hero />
          <Features />
          <QuickStart />
        </main>
        <Footer />
      </div>
    );
  }
}
