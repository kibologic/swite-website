import { SwissComponent } from '@kibologic/core';
import { Shell } from '../components/Shell.uix';

component LandingPage {
  props = {};

  code(lines: string[]) {
    return (
      <div class="sw-code">
        <pre>{lines.join('\n')}</pre>
      </div>
    );
  }

  render() {
    return (
      <Shell activeRoute="/">
        <div class="sw-hero">
          <h1 class="sw-h1">Swite is the dev server and compiler host for SwissJS applications.</h1>
          <p class="sw-lede">
            It serves <span class="sw-inline">.ui</span> / <span class="sw-inline">.uix</span>, owns module resolution across workspace layouts,
            and runs HMR for fast iteration. Source of truth is <span class="sw-inline">kibologic/swite</span>.
          </p>
        </div>

        <div class="sw-content">
          <div class="sw-grid">
            <div class="sw-card">
              <h3>CLI</h3>
              <p>Primary commands are <span class="sw-inline">dev</span>, <span class="sw-inline">start</span>, and <span class="sw-inline">build</span>.</p>
            </div>
            <div class="sw-card">
              <h3>Config surface</h3>
              <p>Config supports root/publicDir, python services (for backend wiring), resolver, and dev server options.</p>
            </div>
            <div class="sw-card">
              <h3>Resolver model</h3>
              <p>Swite maps workspace + sibling <span class="sw-inline">node_modules</span> layouts to stable browser paths.</p>
            </div>
            <div class="sw-card">
              <h3>HMR</h3>
              <p>WebSocket HMR engine pushes compiled updates without full reload where possible.</p>
            </div>
          </div>

          {this.code([
            '# Typical site/dev server entry (dev.mjs)',
            "import { SwiteServer } from '@kibologic/swite';",
            '',
            'const server = new SwiteServer({',
            "  root: new URL('./app', import.meta.url).pathname,",
            "  publicDir: 'public',",
            '  port: 6002,',
            "  host: '0.0.0.0',",
            '});',
            '',
            'await server.start();',
          ])}

          <div class="sw-footer">
            <div>Start in <a class="sw-link" href="/docs">Docs</a>, then read <a class="sw-link" href="/docs/config">Config</a>.</div>
            <div style="font-family: var(--font-mono);">Swite + SwissJS</div>
          </div>
        </div>
      </Shell>
    );
  }
}

