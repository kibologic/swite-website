import { SwissComponent } from '@kibologic/core';
import { Shell } from '../../components/Shell.uix';

component FrameworkReactPage {
  render() {
    return (
      <Shell activeRoute="/framework/react">
        <div style="max-width: 860px;">
          <div style="margin-bottom: 32px;">
            <div style="font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.12em; margin-bottom: 8px;">Cross-Framework</div>
            <h1 style="margin: 0 0 12px; font-size: 42px; letter-spacing: -0.05em;">React + Swite</h1>
            <p style="margin: 0; color: var(--text-secondary); font-size: 16px; line-height: 1.7; max-width: 680px;">
              Swite is a general-purpose build tool. While it is purpose-built for SwissJS, it can build React applications via the <code class="sw-inline-code">swite-plugin-react</code> adapter.
            </p>
          </div>

          <div style="display: flex; flex-direction: column; gap: 28px;">
            <div class="sw-doc-card">
              <h2 style="margin: 0 0 12px; font-size: 20px; font-weight: 700;">Setup</h2>
              <div class="sw-code-block">{"pnpm add @kibologic/swite swite-plugin-react react react-dom\npnpm add -D @types/react @types/react-dom"}</div>
              <div class="sw-code-block" style="margin-top: 12px;">{"// dev.mjs\nimport { createServer } from '@kibologic/swite';\nimport { reactPlugin } from 'swite-plugin-react';\n\nconst server = await createServer({\n  root: './src',\n  entry: 'main.tsx',\n  plugins: [reactPlugin()],\n  port: 5173,\n});\nawait server.listen();"}</div>
            </div>

            <div class="sw-doc-card">
              <h2 style="margin: 0 0 12px; font-size: 20px; font-weight: 700;">React component example</h2>
              <div class="sw-code-block">{"// src/App.tsx\nimport { useState } from 'react';\n\nexport function App() {\n  const [count, setCount] = useState(0);\n  return (\n    <div>\n      <h1>React + Swite</h1>\n      <button onClick={() => setCount(c => c + 1)}>\n        Count: {count}\n      </button>\n    </div>\n  );\n}\n\n// src/main.tsx\nimport { createRoot } from 'react-dom/client';\nimport { App } from './App';\ncreateRoot(document.getElementById('root')!).render(<App />);"}</div>
            </div>

            <div class="sw-doc-card">
              <h2 style="margin: 0 0 12px; font-size: 20px; font-weight: 700;">Why use Swite for React?</h2>
              <div style="display: flex; flex-direction: column; gap: 6px;">
                {[
                  'Faster cold starts than Vite for React projects (single-pass esbuild pipeline)',
                  'Same dev.mjs config format as your SwissJS projects — consistent toolchain',
                  'HMR performance on par with Vite React Fast Refresh',
                  'Smaller configuration surface — no vite.config.ts needed',
                ].map((item, i) => (
                  <div key={String(i)} style="display:flex;gap:8px;font-size:13px;color:var(--text-secondary);">
                    <span style="color:var(--sw-accent);font-weight:800;">✓</span>{item}
                  </div>
                ))}
              </div>
            </div>

            <div class="sw-doc-note">
              <code class="sw-inline-code">swite-plugin-react</code> is currently in development. Star the repo at <code class="sw-inline-code">github.com/kibologic/swite-plugin-react</code> to follow progress.
            </div>
          </div>
        </div>
      </Shell>
    );
  }
}
