import { SwissComponent } from '@swissjs/core';
import { Shell } from '../../components/Shell.uix';

component FeaturesPluginsPage {
  render() {
    return (
      <Shell activeRoute="/features/plugins">
        <div style="max-width: 860px;">
          <div style="margin-bottom: 32px;">
            <div style="font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.12em; margin-bottom: 8px;">Features</div>
            <h1 style="margin: 0 0 12px; font-size: 42px; letter-spacing: -0.05em;">Plugin API</h1>
            <p style="margin: 0; color: var(--text-secondary); font-size: 16px; line-height: 1.7; max-width: 680px;">
              Swite's plugin API lets you hook into every stage of the dev and build pipeline. Plugins are plain JavaScript objects returned from a factory function.
            </p>
          </div>

          <div style="display: flex; flex-direction: column; gap: 28px;">
            <div class="sw-doc-card">
              <h2 style="margin: 0 0 12px; font-size: 20px; font-weight: 700;">Plugin hooks</h2>
              <table class="sw-table">
                <thead><tr><th>Hook</th><th>When called</th><th>Can return</th></tr></thead>
                <tbody>
                  {[
                    { h: 'transform(code, id)', w: 'Every file requested in dev or during build', r: 'Modified code string or null' },
                    { h: 'configureServer(server)', w: 'After dev server is created', r: 'void — registers middleware' },
                    { h: 'buildStart()', w: 'Before production build starts', r: 'void' },
                    { h: 'buildEnd()', w: 'After production build completes', r: 'void' },
                    { h: 'resolveId(id)', w: 'When an import specifier is resolved', r: 'Resolved path or null' },
                    { h: 'load(id)', w: 'When a module is loaded', r: 'Module code string or null' },
                  ].map(row => (
                    <tr key={row.h}>
                      <td><code class="sw-inline-code" style="font-size:11px;">{row.h}</code></td>
                      <td style="color:var(--text-secondary);font-size:12px;">{row.w}</td>
                      <td style="color:var(--text-muted);font-size:12px;">{row.r}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <div class="sw-doc-card">
              <h2 style="margin: 0 0 12px; font-size: 20px; font-weight: 700;">Minimal plugin</h2>
              <div class="sw-code-block">{"export function myPlugin(opts = {}) {\n  return {\n    name: 'my-plugin',\n\n    transform(code, id) {\n      if (!id.endsWith('.uix')) return null;\n      // Replace a macro in all .uix files\n      return code.replace(/__APP_VERSION__/g, JSON.stringify('1.0.0'));\n    },\n  };\n}\n\n// Usage in dev.mjs:\nimport { myPlugin } from './plugins/my-plugin.mjs';\nconst server = await createServer({ plugins: [myPlugin()] });"}</div>
            </div>

            <div class="sw-doc-card">
              <h2 style="margin: 0 0 12px; font-size: 20px; font-weight: 700;">Plugin ordering</h2>
              <p style="margin: 0 0 14px; color: var(--text-secondary); font-size: 14px; line-height: 1.6;">Plugins run in array order. The Swiss compiler plugin always runs first (it's built-in), then user plugins in declaration order.</p>
              <div class="sw-code-block">{"const server = await createServer({\n  plugins: [\n    // Runs AFTER Swiss compiler transform:\n    fileRouter(),       // 1st user plugin\n    myMacroPlugin(),    // 2nd user plugin\n    cspPlugin(),        // 3rd user plugin\n  ],\n});"}</div>
            </div>
          </div>
        </div>
      </Shell>
    );
  }
}
