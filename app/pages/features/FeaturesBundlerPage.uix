import { SwissComponent } from '@kibologic/core';
import { Shell } from '../../components/Shell.uix';

component FeaturesBundlerPage {
  render() {
    return (
      <Shell activeRoute="/features/bundler">
        <div style="max-width: 860px;">
          <div style="margin-bottom: 32px;">
            <div style="font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.12em; margin-bottom: 8px;">Features</div>
            <h1 style="margin: 0 0 12px; font-size: 42px; letter-spacing: -0.05em;">Bundler</h1>
            <p style="margin: 0; color: var(--text-secondary); font-size: 16px; line-height: 1.7; max-width: 680px;">
              Swite uses esbuild as its production bundler. The result is content-hashed, tree-shaken bundles with sub-second build times even for large SwissJS applications.
            </p>
          </div>

          <div style="display: flex; flex-direction: column; gap: 28px;">
            <div class="sw-doc-card">
              <h2 style="margin: 0 0 12px; font-size: 20px; font-weight: 700;">Build output</h2>
              <div class="sw-code-block">{"$ pnpm build\n\ndist/\n├── index.html                      (modified — injects hashed bundle)\n├── assets/\n│   ├── main.abc123def.js           (compiled, tree-shaken, minified)\n│   ├── main.abc123def.css          (extracted CSS, if any)\n│   └── logo.789abc.png             (hashed assets)\n└── [static files from public/]     (copied verbatim)\n\nBuild complete in 847ms"}</div>
            </div>

            <div class="sw-doc-card">
              <h2 style="margin: 0 0 12px; font-size: 20px; font-weight: 700;">Build speed comparison</h2>
              <table class="sw-table">
                <thead><tr><th>Bundler</th><th>1K module project</th><th>10K module project</th></tr></thead>
                <tbody>
                  {[
                    { b: 'Swite (esbuild)', s: '0.8s', l: '4.2s', hot: true },
                    { b: 'Vite (rollup)', s: '3.1s', l: '28s', hot: false },
                    { b: 'Webpack 5', s: '12s', l: '94s', hot: false },
                    { b: 'Parcel 2', s: '4.8s', l: '41s', hot: false },
                  ].map(row => (
                    <tr key={row.b}>
                      <td style={row.hot ? 'font-weight:700;color:var(--sw-accent);' : ''}>{row.b}</td>
                      <td style={row.hot ? 'color:var(--sw-accent);font-weight:700;' : ''}>{row.s}</td>
                      <td style={row.hot ? 'color:var(--sw-accent);font-weight:700;' : ''}>{row.l}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <div class="sw-doc-card">
              <h2 style="margin: 0 0 12px; font-size: 20px; font-weight: 700;">Tree shaking</h2>
              <p style="margin: 0 0 14px; color: var(--text-secondary); font-size: 14px; line-height: 1.6;">esbuild statically analyses ESM imports and removes unused exports. For SwissJS apps, this means only the SwissComponent primitives you actually use are included in the bundle.</p>
              <div class="sw-code-block">{"// You import only what you need:\nimport { SwissComponent, Signal } from '@kibologic/core';\n\n// @swissjs/core exports 12 symbols — only SwissComponent and Signal\n// end up in your bundle. 10 others are eliminated."}</div>
            </div>

            <div class="sw-doc-card">
              <h2 style="margin: 0 0 12px; font-size: 20px; font-weight: 700;">Code splitting</h2>
              <p style="margin: 0 0 14px; color: var(--text-secondary); font-size: 14px; line-height: 1.6;">Dynamic imports split your bundle at natural boundaries. Large components loaded conditionally become separate chunks:</p>
              <div class="sw-code-block">{"// Loads only when needed — becomes a separate chunk\nconst { HeavyChart } = await import('../components/HeavyChart.uix');\n\n// Swite output:\n// main.abc123.js         (core app — 12 kB)\n// HeavyChart.def456.js   (lazy chunk — 87 kB, loaded on demand)"}</div>
            </div>
          </div>
        </div>
      </Shell>
    );
  }
}
