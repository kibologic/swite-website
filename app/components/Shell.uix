import { SwissComponent } from '@kibologic/core';

component Shell {
  props = {
    activeRoute: string
  };

  state { let theme: 'light' | 'dark' = 'dark'; }

  mounted() {
    const saved = localStorage.getItem('swite-theme') as 'light' | 'dark' | null;
    this.theme = saved || 'dark';
    document.documentElement.setAttribute('data-theme', this.theme);
  }

  toggleTheme() {
    this.theme = this.theme === 'light' ? 'dark' : 'light';
    document.documentElement.setAttribute('data-theme', this.theme);
    localStorage.setItem('swite-theme', this.theme);
    this.scheduleUpdate?.();
  }

  renderLink(link: { name: string; path: string; note?: string }) {
    const active = this.props.activeRoute === link.path;
    return (
      <a href={link.path} class="sw-nav__a" data-active={active ? 'true' : 'false'}>
        <span class="sw-nav__name">{link.name}</span>
        {link.note ? <span class="sw-nav__note">{link.note}</span> : null}
      </a>
    );
  }

  render() {
    const sections = [
      {
        title: 'Overview',
        links: [
          { name: 'Introduction', path: '/docs', note: 'What Swite is and where it fits' },
          { name: 'Why Swite', path: '/why-swite', note: 'Why Kibologic built it' }
        ]
      },
      {
        title: 'Workflow',
        links: [
          { name: 'Installation', path: '/docs/install', note: 'Package and repo setup' },
          { name: 'Configuration', path: '/docs/config', note: 'server and services.python' },
          { name: 'CLI Commands', path: '/docs/cli', note: 'dev, start, build' }
        ]
      },
      {
        title: 'Architecture',
        links: [
          { name: 'HMR', path: '/docs/hmr', note: 'WebSocket engine and update model' },
          { name: 'Module Resolution', path: '/docs/resolution', note: 'workspace and node_modules handling' },
          { name: 'Plugin Surface', path: '/docs/plugins', note: 'file-router and server integration' },
          { name: 'Troubleshooting', path: '/docs/errors', note: 'Common failure modes' }
        ]
      }
    ];

    return (
      <div>
        <header class="sw-topbar">
          <div class="sw-topbar__inner">
            <a class="sw-brand" href="/">
              <div class="sw-mark" aria-hidden="true"></div>
              <div>
                <div class="sw-brand__name">Swite</div>
                <div class="sw-brand__tag">dev server + compiler host</div>
              </div>
            </a>

            <div class="sw-actions">
              <a href="/docs" class="sw-link">Docs</a>
              <a href="/why-swite" class="sw-link">Why</a>
              <a href="https://github.com/kibologic/swite" target="_blank" rel="noreferrer" class="sw-link">GitHub</a>
              <button type="button" class="sw-btn" onclick={() => this.toggleTheme()}>
                {this.theme === 'light' ? 'DARK' : 'LIGHT'}
              </button>
            </div>
          </div>
        </header>

        <div class="sw-frame">
          <aside class="sw-sidebar">
            <div class="sw-sidebar__hd">
              <div class="sw-sidebar__k">Developer Guide</div>
              <div class="sw-sidebar__t">Documentation</div>
            </div>

            <div class="sw-nav">
              {sections.map((section) => (
                <section key={section.title} class="sw-nav__section">
                  <h4>{section.title}</h4>
                  {section.links.map((link) => this.renderLink(link))}
                </section>
              ))}
            </div>
          </aside>

          <main class="sw-main">
            {this.children}
          </main>
        </div>
      </div>
    );
  }
}
