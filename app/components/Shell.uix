import { SwissComponent } from '@kibologic/core';

component Shell {
  props = {
    activeRoute: string
  };

  state { let theme: 'light' | 'dark' = 'dark'; }

  mounted() {
    const saved = localStorage.getItem('swite-theme') as 'light' | 'dark' | null;
    this.theme = saved || 'dark';
    document.documentElement.setAttribute('data-theme', this.theme);

    if (!document.getElementById('swite-doc-styles')) {
      const s = document.createElement('style');
      s.id = 'swite-doc-styles';
      s.textContent = `
        :root {
          --sw-accent: #df8f19;
          --sw-accent-strong: #b56e09;
          --sw-accent-soft: rgba(223, 143, 25, 0.12);
        }

        [data-theme="light"] {
          --bg-page: #fcfcfb;
          --bg-panel: #f3f2ef;
          --bg-code: #111111;
          --text-primary: #111111;
          --text-secondary: #4f4f4a;
          --text-muted: #787871;
          --border: #ddd9d0;
          --border-strong: #c7c0b2;
        }

        [data-theme="dark"] {
          --bg-page: #0d0d0c;
          --bg-panel: #171715;
          --bg-code: #0a0a09;
          --text-primary: #f2f1ed;
          --text-secondary: #b9b6ae;
          --text-muted: #87837a;
          --border: #292824;
          --border-strong: #3a3833;
        }

        * { box-sizing: border-box; }
        html, body { margin: 0; padding: 0; }
        body {
          font-family: "JetBrains Mono", "Fira Code", monospace;
          background: var(--bg-page);
          color: var(--text-primary);
          line-height: 1.6;
        }

        .sw-site-shell { min-height: 100vh; background: var(--bg-page); color: var(--text-primary); }
        .sw-shell-link { color: var(--text-secondary); text-decoration: none; }
        .sw-shell-link:hover { color: var(--text-primary); }
        .sw-shell-link-active { color: var(--sw-accent); }
        .sw-inline-code {
          font-family: inherit;
          background: var(--bg-panel);
          border: 1px solid var(--border);
          border-radius: 4px;
          padding: 2px 6px;
          font-size: 0.92em;
        }
        .sw-code-block {
          background: var(--bg-code);
          color: #f6e7c4;
          border: 1px solid var(--border);
          border-radius: 10px;
          padding: 18px 20px;
          overflow-x: auto;
          font-size: 13px;
          line-height: 1.7;
        }
        .sw-doc-card {
          background: var(--bg-panel);
          border: 1px solid var(--border);
          border-radius: 10px;
          padding: 24px;
        }
        .sw-doc-note {
          border-left: 4px solid var(--sw-accent);
          background: var(--sw-accent-soft);
          padding: 16px 18px;
          border-radius: 0 8px 8px 0;
          color: var(--text-secondary);
          font-size: 14px;
        }
        .sw-doc-warning {
          border-left: 4px solid #ef4444;
          background: rgba(239, 68, 68, 0.08);
          padding: 16px 18px;
          border-radius: 0 8px 8px 0;
          color: var(--text-secondary);
          font-size: 14px;
        }
        .sw-code-block { white-space: pre; }
        .sw-table { width: 100%; border-collapse: collapse; font-size: 13px; }
        .sw-table th {
          text-align: left; padding: 10px 14px;
          background: var(--bg-panel); border-bottom: 2px solid var(--border);
          color: var(--text-muted); font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em;
        }
        .sw-table td { padding: 10px 14px; border-bottom: 1px solid var(--border); color: var(--text-secondary); }
        .sw-table tr:last-child td { border-bottom: none; }

        @media (max-width: 980px) {
          .sw-shell-frame { display: block !important; }
          .sw-shell-sidebar {
            width: auto !important;
            height: auto !important;
            position: static !important;
            border-right: none !important;
            border-bottom: 1px solid var(--border);
          }
          .sw-shell-main { padding: 40px 20px 80px !important; }
        }
      `;
      document.head.appendChild(s);
    }
  }

  toggleTheme() {
    this.theme = this.theme === 'light' ? 'dark' : 'light';
    document.documentElement.setAttribute('data-theme', this.theme);
    localStorage.setItem('swite-theme', this.theme);
    this.scheduleUpdate?.();
  }

  renderLink(link: { name: string; path: string; note?: string }) {
    const active = this.props.activeRoute === link.path;
    return (
      <a
        href={link.path}
        class={active ? 'sw-shell-link sw-shell-link-active' : 'sw-shell-link'}
        style="display: block; font-size: 13px; font-weight: 700; margin-bottom: 12px;"
      >
        {link.name}
        {link.note ? <span style="display: block; font-size: 11px; font-weight: 500; color: var(--text-muted); margin-top: 2px;">{link.note}</span> : null}
      </a>
    );
  }

  render() {
    const sections = [
      { title: 'Overview', links: [
        { name: 'Introduction', path: '/docs' },
        { name: 'Why Swite', path: '/why-swite' },
        { name: 'Benchmarks', path: '/benchmarks' },
      ]},
      { title: 'Features', links: [
        { name: 'Compiler', path: '/features/compiler' },
        { name: 'Bundler', path: '/features/bundler' },
        { name: 'HMR', path: '/features/hmr' },
        { name: 'Plugin API', path: '/features/plugins' },
        { name: 'Tree Shaking', path: '/features/tree-shaking' },
      ]},
      { title: 'Plugin Ecosystem', links: [
        { name: 'All Plugins', path: '/plugins' },
        { name: 'React + Swite', path: '/framework/react' },
        { name: 'Vue + Swite', path: '/framework/vue' },
      ]},
      { title: 'Workflow', links: [
        { name: 'Installation', path: '/docs/install' },
        { name: 'Configuration', path: '/docs/config' },
        { name: 'CLI Commands', path: '/docs/cli' },
        { name: 'Plugin Authoring', path: '/docs/plugin-authoring' },
        { name: 'Transforms', path: '/docs/transforms' },
      ]},
      { title: 'Architecture', links: [
        { name: 'Module Resolution', path: '/docs/resolution' },
        { name: 'Static Files', path: '/docs/static' },
        { name: 'Troubleshooting', path: '/docs/errors' },
      ]},
    ];

    return (
      <div class="sw-site-shell">
        <nav style="height: 64px; border-bottom: 1px solid var(--border); background: var(--bg-page); position: sticky; top: 0; z-index: 50;">
          <div style="max-width: 1360px; margin: 0 auto; padding: 0 20px; height: 100%; display: flex; align-items: center; justify-content: space-between; gap: 20px;">
            <div style="display: flex; align-items: center; gap: 24px;">
              <a href="/" style="display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--text-primary); font-size: 18px; font-weight: 900;">
                <span style="width: 18px; height: 18px; background: var(--sw-accent); display: inline-block; clip-path: polygon(50% 0%, 0% 100%, 100% 100%);"></span>
                swite
              </a>
              <div style="font-size: 12px; color: var(--text-muted);">SwissJS dev server and runtime toolchain</div>
            </div>
            <div style="display: flex; align-items: center; gap: 18px;">
              <a href="/docs" class="sw-shell-link" style="font-size: 12px; font-weight: 700;">Docs</a>
              <a href="/why-swite" class="sw-shell-link" style="font-size: 12px; font-weight: 700;">Why Swite</a>
              <a href="https://github.com/kibologic/swite" target="_blank" class="sw-shell-link" style="font-size: 12px; font-weight: 700;">GitHub</a>
              <button
                type="button"
                onclick={() => this.toggleTheme()}
                style="background: none; border: 1px solid var(--border); border-radius: 999px; color: var(--text-secondary); cursor: pointer; font: inherit; padding: 7px 12px; font-size: 11px; font-weight: 800;"
              >
                {this.theme === 'light' ? 'DARK' : 'LIGHT'}
              </button>
            </div>
          </div>
        </nav>

        <div class="sw-shell-frame" style="display: flex; max-width: 1360px; margin: 0 auto; width: 100%;">
          <aside class="sw-shell-sidebar" style="width: 290px; border-right: 1px solid var(--border); padding: 28px 20px 48px; position: sticky; top: 64px; height: calc(100vh - 64px); overflow-y: auto;">
            <div style="margin-bottom: 22px; font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.14em;">Developer Guide</div>
            {sections.map((section) => (
              <section key={section.title} style="margin-bottom: 34px;">
                <h4 style="margin: 0 0 14px; font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.14em;">{section.title}</h4>
                {section.links.map((link) => this.renderLink(link))}
              </section>
            ))}
          </aside>

          <main class="sw-shell-main" style="flex: 1; min-width: 0; padding: 48px 56px 96px;">
            {this.children}
          </main>
        </div>
      </div>
    );
  }
}
