import { mount, Signal, SwissComponent, createElement, Fragment } from '@swissjs/core';
import { LandingPage } from './pages/LandingPage.uix';
import { DocsPage } from './pages/DocsPage.uix';
import { BenchmarksPage } from './pages/BenchmarksPage.uix';
import { PluginEcosystemPage } from './pages/PluginEcosystemPage.uix';
import { FeaturesCompilerPage } from './pages/features/FeaturesCompilerPage.uix';
import { FeaturesBundlerPage } from './pages/features/FeaturesBundlerPage.uix';
import { FeaturesHMRPage } from './pages/features/FeaturesHMRPage.uix';
import { FeaturesPluginsPage } from './pages/features/FeaturesPluginsPage.uix';
import { FeaturesTreeShakingPage } from './pages/features/FeaturesTreeShakingPage.uix';
import { FrameworkReactPage } from './pages/framework/FrameworkReactPage.uix';
import { FrameworkVuePage } from './pages/framework/FrameworkVuePage.uix';

globalThis.createElement = createElement;
globalThis.Fragment = Fragment;

const route$ = new Signal(window.location.pathname);

window.addEventListener('popstate', () => {
  route$.value = window.location.pathname;
  window.scrollTo(0, 0);
});

document.addEventListener('click', (e: any) => {
  const link = e.target.closest('a');
  if (link && link.href && link.href.startsWith(window.location.origin) && !link.target && !e.metaKey && !e.ctrlKey) {
    const path = link.getAttribute('href');
    if (path && path.startsWith('/') && !path.includes('#')) {
      e.preventDefault();
      history.pushState(null, '', path);
      route$.value = path;
      window.scrollTo(0, 0);
    }
  }
});

component Router {
  render() {
    const r = route$.value;
    if (r === '/' || r === '') return <LandingPage />;
    if (r === '/benchmarks') return <BenchmarksPage />;
    if (r === '/plugins') return <PluginEcosystemPage />;
    if (r === '/features/compiler') return <FeaturesCompilerPage />;
    if (r === '/features/bundler') return <FeaturesBundlerPage />;
    if (r === '/features/hmr') return <FeaturesHMRPage />;
    if (r === '/features/plugins') return <FeaturesPluginsPage />;
    if (r === '/features/tree-shaking') return <FeaturesTreeShakingPage />;
    if (r === '/framework/react') return <FrameworkReactPage />;
    if (r === '/framework/vue') return <FrameworkVuePage />;
    if (r.startsWith('/docs')) return <DocsPage route={r} />;
    return <LandingPage />;
  }
}

mount(Router, document.getElementById('app'));
